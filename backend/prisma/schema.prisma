// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  url_img          String?
  username         String
  password         String
  like             Int       @default(0)
  skills           Skills[]
  matchesRequested Match[]   @relation("Requester")
  matchesReceived  Match[]   @relation("Receiver")
  chats            Chat[]    @relation("ChatParticipants")
  messages         Message[]
}

model Skills {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  type        String
  users       Users    @relation(fields: [usersId], references: [id])
  usersId     Int
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  Int
}

model Category {
  id     Int      @id @default(autoincrement())
  name   String
  skills Skills[]
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RatingStatus {
  UP
  DOWN
}

model Match {
  id              Int           @id @default(autoincrement())
  ratingRequester RatingStatus?
  ratingReceiver  RatingStatus?
  requesterId     Int
  receiverId      Int
  user_requester  Users         @relation("Requester", fields: [requesterId], references: [id])
  user_receiver   Users         @relation("Receiver", fields: [receiverId], references: [id])
  status          MatchStatus   @default(PENDING)
}

model Chat {
  id           String    @id @default(uuid())
  participants Users[]   @relation("ChatParticipants")
  messages     Message[]
  createAt     DateTime  @default(now())
}

model Message {
  id       String   @id @default(uuid())
  text     String
  chat     Chat     @relation(fields: [chatId], references: [id])
  sender   Users    @relation(fields: [usersId], references: [id])
  createAt DateTime @default(now())
  chatId   String
  usersId  Int
}
